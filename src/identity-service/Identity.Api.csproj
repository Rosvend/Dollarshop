<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    identity-service — supporting (DDD), demo stub.
    Returns a fake user profile so any caller (e.g. the API Gateway, a frontend
    during the demo) can fetch the customer context. No DDD layers, no DB.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Identity.Api</RootNamespace>
    <AssemblyName>Identity.Api</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

</Project>
