<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Sales.Infrastructure — Infrastructure layer of the sales-service.
    Implements the ports declared by the inner layers: ICartRepository and
    IEventPublisher (Domain); IUnitOfWork, IStockReservationService and
    IPaymentGatewayService (Application). The ORM, RabbitMQ, the Outbox relay,
    the Finance ACL and the resilient REST clients all live ONLY here — the
    Domain and Application layers never depend on a persistence or transport
    technology.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Sales.Infrastructure</RootNamespace>
    <AssemblyName>Sales.Infrastructure</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sales.Application\Sales.Application.csproj" />
    <ProjectReference Include="..\Sales.Domain\Sales.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Pinned to 10.0.4 to match the EF Core version Npgsql 10.0.1 depends on,
         so every Microsoft.EntityFrameworkCore.* assembly resolves to one version. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.4" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.4">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="10.0.8" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.8" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="10.6.0" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.8" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.1" />
    <PackageReference Include="RabbitMQ.Client" Version="7.2.1" />
  </ItemGroup>

</Project>
